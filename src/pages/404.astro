---
import Layout from "../layouts/Layout.astro";
import { Icon } from "astro-icon/components";
---

<Layout title="Page not found">
  <main class="grid min-h-svh place-items-center px-6 text-center">
    <div>
      <h1 class="text-foreground mt-4 text-4xl font-medium tracking-tight sm:text-5xl">Page not found</h1>
      <p class="text-muted mt-4">This page doesn't exist or may have moved.</p>
      <a
        href="/"
        class="text-foreground hover:text-muted mt-8 inline-flex items-center gap-1.5 text-sm underline underline-offset-4"
      >
        <Icon name="lucide:arrow-left" class="size-4" aria-hidden="true" />
        Back to home
      </a>
    </div>
  </main>
</Layout>
